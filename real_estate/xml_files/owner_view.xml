<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--form view for owner Model-->
        <record id="owner_list_form" model="ir.ui.view">
            <field name="name">owner form View</field>
            <field name="model">owner</field>
            <field name="arch" type="xml">
                <form class="form_header">
                    <sheet>
                        <div class="oe_avatar" style="float:right; margin-right:20px;">
                            <field name="image_1920" widget="image"
                                class="oe_avatar"
                                options="{'preview_image': 'image_256'}"/>
                        </div>

                        <div class="oe_title">
                            <label for= "name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="general info">
                                <field name="phone"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Property">
                                <field name="properties" widget="one2many_list" string="Properties">
                                    <list editable="bottom">
                                        <field name="ref"/>
                                        <field name="name"/>
                                        <field name="bedrooms" string="Num Of Bedrooms"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>


        <!--list view for owner Model-->
        <record id="view_owner_list" model="ir.ui.view">
            <field name="name">owner.list.view</field>
            <field name="model">owner</field>
            <field name="arch" type="xml">
                <list class="custom_header">
                    <field name="name"/>
                    <field name="address"/>
                    <field name="properties" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <!-- Enhanced Search View for Owners -->
        <record id="owner_search_view" model="ir.ui.view">
          <field name="name">Owner Search View</field>
          <field name="model">owner</field>
          <field name="arch" type="xml">
            <search string="Search For Owners">
              <field name="name"/>
              <field name="phone"/>
              <filter name="group_address" string="Group by Address" context="{'group_by':'address'}"/>
            </search>
          </field>
        </record>


        <!-- Action for owner Model -->
        <record id="owner_action_rec" model="ir.actions.act_window">
            <field name="name">owners</field>
            <field name="res_model">owner</field>
        </record>

        <record id="owner_list_search" model="ir.ui.view">
            <field name="name">owner search View</field>
            <field name="model">owner</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="has_properties" string="has property" domain="[('properties','=','True')]"/>
                </search>
            </field>
        </record>

        <!-- Menu Item to Access the Action -->
        <menuitem
            id="owner_menu"
            name="owners"
            parent="base_menu_id"
            action="owner_action_rec"
        />
    </data>
</odoo>
