<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="property_category" model="ir.module.category">
            <field name="name">Real Estate Groups</field>
        </record>

        <record id="manager_group_id" model="res.groups">
            <field name="name">Real Estate Manager</field>
            <field name="category_id" ref="real_estate.property_category"/>
        </record>

        <record id="property_group_id" model="res.groups">
            <field name="name">Real Estate User</field>
            <field name="category_id" ref="real_estate.property_category"/>
        </record>

        <record id="access_rule_property" model="ir.rule">
            <field name="name">Property by User</field>
            <field name="model_id" ref="model_property"/>
            <field name="groups" eval="[(4, ref('real_estate.property_group_id'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>